[Unit]
Description=Home desktop automations
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=io.github.design_nexus.nyx.Home.Automation
ExecStart=@BINDIR@/nyx-homed
Restart=on-failure
RestartSec=3
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=graphical-session.target
